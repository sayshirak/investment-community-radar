      "stock",
      "bitcoin"
    ],
    "secondary_nodes": [
      "programmer",
      "business",
      "mileage",
      "career",
      "qna",
      "life",
      "create"
    ],
    "include_recent": true,
    "pages_per_node": 3,
    "recent_pages": 2,
    "exclude_communities": [
      "promotions"
    ],
    "exclude_brokerage_ad_terms": [
